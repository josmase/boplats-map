{
  "name": "boplats-map",
  "version": "0.0.25",
  "type": "module",
  "description": "An apartment mapping application using web scraping and Bun runtime",
  "workspaces": [
    "apps/api",
    "apps/scraper",
    "apps/web",
    "libs/apartment-application-state-scraper",
    "libs/apartment-repository",
    "libs/apartment-scraper",
    "libs/geocoding",
    "libs/mongoose",
    "libs/rate-limit"
  ],
  "scripts": {
    "dev:api": "bun --filter api run dev",
    "dev:scraper": "bun --filter scraper run start",
    "dev:web": "bun --filter web run dev",
    "build:api": "bun --filter api run build",
    "build:scraper": "bun --filter scraper run build",
    "build:web": "bun --filter web run build",
    "test": "bun test",
    "test:api": "bun --filter api test",
    "test:scraper": "bun --filter scraper test",
    "test:web": "bun --filter web test",
    "test:libs": "bun --filter '@boplats/*' test"
  },
  "devDependencies": {
    "bun-types": "^1.3.6",
    "typescript": "^5.6.2"
  }
}
